# Copy this file to .env locally (and set the same vars in Render's
# environment settings for production). .env is already in .gitignore.

# Flask session secret. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Without this set, the app falls back to a random key that changes on every
# restart/redeploy, logging everyone out each time.
SECRET_KEY=

# Stripe (Phase 2 — online giving).
# Get these from the Stripe dashboard once you have an account:
#   STRIPE_SECRET_KEY     -> Developers > API keys (starts with sk_test_... in test mode)
#   STRIPE_WEBHOOK_SECRET -> Developers > Webhooks > (your endpoint) > Signing secret,
#                            or from `stripe listen` for local testing (starts with whsec_...)
# Until STRIPE_SECRET_KEY is set, /give just shows "not set up yet" -- nothing
# else breaks. STRIPE_PUBLISHABLE_KEY isn't needed: this app redirects to a
# Stripe-hosted Checkout page server-side, so no Stripe.js/publishable key
# is used on the giving page itself.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
